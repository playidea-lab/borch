{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    // `ESNext.Disposable` 은 `using` 선언과 `Symbol.dispose` 의 타입이다.
    // **런타임 지원은 재봤다** — 이 저장소가 쓰는 브라우저에 `Symbol.dispose` 와
    // `Symbol.asyncDispose` 가 둘 다 있다. target 이 ES2022 라 컴파일러가 도우미를
    // 같이 내보내는데, 그 도우미도 그 심볼 위에 선다.
    "lib": ["ES2022", "DOM", "ESNext.Disposable"],
    // WebGPU 타입은 아직 TypeScript 의 기본 DOM 라이브러리에 없다. W3C 사양에서
    // 생성된 타입 전용 패키지이며, 손으로 옮겨 적으면 그 자체가 틀릴 자리가 된다.
    "types": ["@webgpu/types"],
    "outDir": "dist",
    "rootDir": ".",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    "declaration": true,
    "sourceMap": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
