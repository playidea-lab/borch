__pycache__/
*.pyc
.pytest_cache/
.coverage
dist/

# 가상환경과 도구 설정. 지금까지는 이 기계의 전역 설정이 막아주고 있었는데,
# 공개하면 클론하는 사람에게는 그 보호가 없다 — 여기 적어야 모두에게 적용된다.
.venv/
.claude/
.mcp.json

# typescript 하나뿐이지만 그 의존 트리가 통째로 들어온다. **package-lock.json 은
# 커밋한다** — 무엇이 이 기계에 들어왔는지가 저장소에 남아야 한다.
node_modules/
borch-ts/dist/

# 골든은 생성물이다 — 1단계(네이티브 + torch)가 굳히고 2단계가 읽는다.
tests/golden.npz
#
# **`tests/golden.json` 은 여기 없다. 일부러다.**
# npz 는 우리 도구가 만들고 우리 도구가 읽는다. JSON 은 반대로 **우리 도구를 못 돌리는
# 쪽이 읽으라고** 만든 것이라, 무시하면 존재 이유가 사라진다 — 받는 쪽이 파이썬과
# 진짜 torch 를 깔아야 한다면 그건 언어 중립이 아니다. 290KB 이고, 낡으면 매니페스트
# 해시가 갈린다(tests/test_export_json.py 가 그것을 붙잡는다).

# 진짜 torch 에 규약을 물어보는 일회용 스크립트들.
#
# **버리는 것이 맞다.** 물어서 얻은 답은 골든에 굳고 이유는 주석에 남으므로, 물어본
# 절차까지 저장소에 둘 이유가 없다 — 남겨 두면 다음 사람이 "이건 왜 있지" 를 묻는
# 파일이 하나씩 는다. 다시 물어야 하면 다시 쓰는 것이 싸다.
tests/probe_*.py
tests/browser/probe_*.py
tests/fix_*.py

# CIFAR-10 원본. 브라우저는 CORS 때문에 직접 못 받으므로 로컬로 받아 서빙한다.
cifar-10-*
cifar-batch*.bin
cifar-fake.bin

# 바깥에서 받아온 것 — 저장소에는 **해시만** 둔다(tests/browser/assets.lock).
# 28MB 이고, 그중 numpy 하나가 12MB 다. 이 프로젝트가 파는 것은 17KB 짜리 휠이다.
vendor/

# 튜토리얼이 쓰는 데이터 부분집합. site/fetch_data.py 가 만든다 — vendor/ 와 같은 자리다.
site/assets/data/
